datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Workshop {
  id           String    @id @default(uuid())
  name         String
  cnpj         String?
  address      String?
  phone        String?
  whatsapp     String?
  email        String?
  logoUrl      String?
  autoSequence Boolean   @default(true)
  nextOSNumber Int       @default(1)
  pdfNotes     String?
  createdAt    DateTime  @default(now())

  users        User[]
  clients      Client[]
  services     ServiceItem[]
  parts        PartItem[]
  workOrders   WorkOrder[]
  billings     Billing[]
  transactions FinancialTransaction[]
  subscription Subscription?
  fiscalConfig FiscalConfig?
}

model User {
  id               String   @id @default(uuid())
  tenantId         String
  name             String
  email            String   @unique
  passwordHash     String
  role             String   @default("ADMIN") // ADMIN, MECHANIC
  refreshTokenHash String?
  createdAt        DateTime @default(now())

  workshop         Workshop @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Client {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  cpfCnpj   String?
  phone     String
  whatsapp  String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  workshop  Workshop  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  workOrders WorkOrder[]
}

model Vehicle {
  id        String   @id @default(uuid())
  tenantId  String
  clientId  String
  plate     String
  brand     String
  model     String
  year      String
  chassis   String?
  odometer  String   @default("0")
  createdAt DateTime @default(now())

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]
}

model ServiceItem {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String?
  description String?
  price       Float
  createdAt   DateTime @default(now())

  workshop    Workshop @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PartItem {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  code          String?
  supplier      String?
  purchasePrice Float
  salePrice     Float
  stock         Int      @default(0)
  createdAt     DateTime @default(now())

  workshop      Workshop @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model WorkOrder {
  id            String    @id @default(uuid())
  tenantId      String
  osNumber      String
  date          String    // YYYY-MM-DD
  clientId      String
  vehicleId     String
  notes         String?
  status        String    @default("ABERTA") // ABERTA, EM_ANDAMENTO, CONCLUIDA, ENTREGUE, CANCELADA
  servicesTotal Float
  partsTotal    Float
  grandTotal    Float
  signature     String?
  createdAt     DateTime  @default(now())

  workshop      Workshop  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  services      WorkOrderService[]
  parts         WorkOrderPart[]
  billing       Billing?
  fiscalInvoices FiscalInvoice[]
}

model WorkOrderService {
  id        String    @id @default(uuid())
  osId      String
  name      String
  price     Float
  quantity  Int

  workOrder WorkOrder @relation(fields: [osId], references: [id], onDelete: Cascade)
}

model WorkOrderPart {
  id        String    @id @default(uuid())
  osId      String
  name      String
  code      String?
  salePrice Float
  quantity  Int

  workOrder WorkOrder @relation(fields: [osId], references: [id], onDelete: Cascade)
}

model Billing {
  id            String        @id @default(uuid())
  tenantId      String
  osId          String?       @unique
  customClientName String?
  customDescription String?
  amount        Float
  paymentMethod String
  status        String        @default("PENDENTE") // PENDENTE, PARCIALMENTE_PAGO, PAGO
  dueDate       String        // YYYY-MM-DD
  createdAt     DateTime      @default(now())

  workshop      Workshop      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder     WorkOrder?    @relation(fields: [osId], references: [id], onDelete: Cascade)
  installments  BillingInstallment[]
}

model BillingInstallment {
  id        String   @id @default(uuid())
  billingId String
  number    Int
  amount    Float
  dueDate   String   // YYYY-MM-DD
  status    String   @default("PENDENTE") // PAGO, PENDENTE
  paidAt    DateTime?

  billing   Billing  @relation(fields: [billingId], references: [id], onDelete: Cascade)
}

model FinancialTransaction {
  id          String          @id @default(uuid())
  tenantId    String
  type        String          @default("ENTRADA") // ENTRADA, SAIDA
  category    String
  amount      Float
  date        String          // YYYY-MM-DD
  description String?
  createdAt   DateTime        @default(now())

  workshop    Workshop        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Subscription {
  id              String             @id @default(uuid())
  tenantId        String             @unique
  plan            String             @default("PRO")
  status          String             @default("TRIAL") // ACTIVE, TRIAL, PENDING, OVERDUE, CANCELED, EXPIRED
  dueDate         DateTime
  paymentProvider String?
  paymentId       String?
  invoiceUrl      String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workshop        Workshop           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FiscalConfig {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  cnpj              String
  inscricaoMunicipal String?
  inscricaoEstadual  String?
  regimeTributario  Int      @default(1)
  optanteSimples    Boolean  @default(true)
  aliquotaISS       Float    @default(0)
  focusTokenSandbox String?
  focusTokenProd    String?
  focusCompanyId    String?
  hasCertificate    Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  workshop          Workshop @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FiscalInvoice {
  id            String        @id @default(uuid())
  tenantId      String
  osId          String
  type          String        // NFSE, NFE
  status        String        @default("PENDENTE") // PENDENTE, PROCESSANDO, AUTORIZADA, REJEITADA, CANCELADA
  focusReference String       @unique
  invoiceNumber String?
  accessKey     String?
  pdfUrl        String?
  xmlUrl        String?
  errorMessage  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workOrder     WorkOrder     @relation(fields: [osId], references: [id], onDelete: Cascade)
}
