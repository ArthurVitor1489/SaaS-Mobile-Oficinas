{
  "expo": {
    "name": "MecânicaPro",
    "slug": "mecanicapro-mobile",
    "icon": "./assets/icon.png",
    "version": "1.0.8",
    "orientation": "default",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f1115"
    },
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1115",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mecanicapro.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f1115"
      },
      "package": "com.mecanicapro.app",
      "versionCode": 10,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "owner": "hudraf",
    "plugins": [
      "expo-secure-store",
      [
        "react-native-iap",
        {
          "paymentProvider": "Play Store"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "87af8212-d969-4de7-af19-2916c5c26f1b"
      }
    }
  }
}
